# -------------------------------------------------------------------
# Git Attributes configuration file
# optimised for HDL projects (generated by copilot)
# -------------------------------------------------------------------
#
# Team notes :
# 1. This file enforces consistent line endings across all platforms
#    (Linux, macOS, Windows) to avoid cross‑system issues.
# 2. After updating this file, normalise existing files with:
#       git add --renormalize .
#    Review the diff carefully before committing.
# 3. Recommended repository setting to prevent conflicts:
#       git config core.autocrlf false
# 4. Binary files are explicitly marked to ensure Git does not attempt
#    to alter them or apply text filters.
#
# -------------------------------------------------------------------
# General rules
# -------------------------------------------------------------------

# Normalise text with LF endings by default
* text=auto eol=lf

# -------------------------------------------------------------------
# Hardware description languages (HDL)
# -------------------------------------------------------------------
*.vhdl   text eol=lf
*.vhd    text eol=lf
*.v      text eol=lf
*.sv     text eol=lf
*.svh    text eol=lf

# -------------------------------------------------------------------
# Constraints and project settings
# -------------------------------------------------------------------
*.xdc    text eol=lf
*.ucf    text eol=lf
*.sdc    text eol=lf
*.qsf    text eol=lf
*.xpr    text eol=lf
*.qip    text eol=lf
*.xci    text eol=lf

# -------------------------------------------------------------------
# Memory initialisation files
# -------------------------------------------------------------------
*.mif    text eol=lf
*.coe    text eol=lf

# -------------------------------------------------------------------
# Scripts
# -------------------------------------------------------------------
*.tcl    text eol=lf
*.do     text eol=lf
*.sh     text eol=lf
*.py     text eol=lf

# Windows scripts (require CRLF endings)
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# -------------------------------------------------------------------
# General source code and documentation
# -------------------------------------------------------------------
*.c      text eol=lf
*.cpp    text eol=lf
*.h      text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.json   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.csv    text eol=lf
*.rst    text eol=lf

# -------------------------------------------------------------------
# Binary artefacts (must not be altered)
# -------------------------------------------------------------------
*.bin    binary
*.elf    binary
*.bit    binary
*.rbt    binary
*.sof    binary
*.hex    binary
*.dtb    binary
*.dtbo   binary
*.pdf    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.zip    binary
*.7z     binary
*.tar    binary
*.gz     binary

# -------------------------------------------------------------------
# End of file
# -------------------------------------------------------------------
